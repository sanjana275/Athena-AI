# --- Core ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chatgpt
SECRET_KEY=generate-with-python -c "import secrets; print(secrets.token_urlsafe(48))"
FRONTEND_URL=http://localhost:3000

# --- Cookies (production over HTTPS: COOKIE_SECURE=true) ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Hosted LLM (any OpenAI-compatible endpoint) ---
# Hugging Face Inference Providers (default):
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=hf_xxx
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
# Together:   LLM_BASE_URL=https://api.together.xyz/v1

# --- Embeddings ---
# "fastembed" runs a small CPU model inside the backend (no API needed).
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
# For a hosted OpenAI-compatible embeddings API instead:
# EMBED_PROVIDER=openai
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to FRONTEND_URL/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Password-reset email (pick one; with neither, the link is printed in the server log) ---
RESEND_API_KEY=
EMAIL_FROM=ChatGPT Platform <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

MAX_UPLOAD_MB=20
